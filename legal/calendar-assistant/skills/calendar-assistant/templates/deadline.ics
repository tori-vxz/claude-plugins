BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//tori-vxz//calendar-assistant//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VEVENT
UID:{{MATTER_NUMBER}}-{{SLUG}}-{{FINAL_DATE_COMPACT}}@calendar-assistant.local
DTSTAMP:{{NOW_UTC_COMPACT}}
SUMMARY:{{MATTER_NUMBER}} — {{DEADLINE_IN_PLAIN_TERMS}}
DTSTART;VALUE=DATE:{{FINAL_DATE_COMPACT}}
DTEND;VALUE=DATE:{{DAY_AFTER_FINAL_DATE_COMPACT}}
TRANSP:TRANSPARENT
CATEGORIES:Litigation deadline
DESCRIPTION:Matter: {{MATTER_NUMBER}}\nCourt: {{COURT}}\nJudge: {{JUDGE}}\n\nDEADLINE: {{DEADLINE_IN_PLAIN_TERMS}}\n\nGoverning rule: {{RULE_CITE}}\n{{RULE_SOURCE_URL}}\n\nHOW THIS DATE WAS REACHED\nTriggering date: {{TRIGGER_DATE}} ({{TRIGGER_EVENT}})\nPeriod: {{DAYS}} days {{DIRECTION}}\nRaw computed date: {{RAW_DATE}}\nRoll: {{ROLL_NOTE}}\nFinal date: {{FINAL_DATE}}\n\nCounting rule: {{COUNTING_RULE_CITE}}\n{{COUNTING_RULE_SOURCE_URL}}\n\nCalculated {{TODAY}} by calendar-assistant. Verify against the order and your firm's docketing procedure before relying on it.
BEGIN:VALARM
TRIGGER:-P{{REMINDER_DAYS}}D
ACTION:DISPLAY
DESCRIPTION:{{REMINDER_DAYS}} days until: {{DEADLINE_IN_PLAIN_TERMS}} ({{MATTER_NUMBER}})
END:VALARM
END:VEVENT
END:VCALENDAR
